---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const imagesDir = path.join(process.cwd(), 'public/images');
let imageFiles = [];
try {
	if (fs.existsSync(imagesDir)) {
		imageFiles = fs.readdirSync(imagesDir)
		  .filter(file => /\.(jpeg|jpg|png|webp|gif|avif)$/i.test(file))
		  .map(file => `/images/${file}`);
	}
} catch (e) {
	console.error('Error reading images directory', e);
}

const videosDir = path.join(process.cwd(), 'public/videos');
let videoFiles = [];
try {
	if (fs.existsSync(videosDir)) {
		videoFiles = fs.readdirSync(videosDir)
		  .filter(file => /\.(mp4|webm|mov|mkv|avi)$/i.test(file))
		  .map(file => `/videos/${file}`);
	}
} catch (e) {
	console.error('Error reading videos directory', e);
}
